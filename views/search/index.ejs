<%- include('../partials/pageHeader', { pageHeading: 'Search cases' }) %>
<section class="cadms-card"><form class="cadms-filters" method="get" action="/search"><div class="cadms-form-group"><label for="caseId">Case ID</label><input class="cadms-input" id="caseId" name="caseId" inputmode="numeric" value="<%= query.caseId %>"></div><div class="cadms-form-group"><label for="childName">Child name</label><input class="cadms-input" id="childName" name="childName" value="<%= query.childName %>"></div><div class="cadms-form-group"><label for="caseType">Case type</label><select class="cadms-select" id="caseType" name="caseType"><option value="">Any type</option><% CASE_TYPES.forEach(t => { %><option value="<%= t %>" <%= query.caseType === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div><div class="cadms-form-group"><label for="status">Status</label><select class="cadms-select" id="status" name="status"><option value="">Any status</option><% ['Reported','UnderInvestigation','Closed'].forEach(s => { %><option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s === 'UnderInvestigation' ? 'Under investigation' : s %></option><% }) %></select></div><div class="cadms-form-group"><label for="dateFrom">Reported from</label><input class="cadms-input" type="date" id="dateFrom" name="dateFrom" value="<%= query.dateFrom %>"></div><div class="cadms-form-group"><label for="dateTo">Reported to</label><input class="cadms-input" type="date" id="dateTo" name="dateTo" value="<%= query.dateTo %>"></div><button class="cadms-btn cadms-btn--primary">Search</button><a class="cadms-btn cadms-btn--outline" href="/search">Clear</a></form></section>
<% if (results) { %><section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Search results</h2><span><%= results.length %> cases</span></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Case</th><th>Child</th><th>Type</th><th>Status</th><th>Date reported</th><th></th></tr></thead><tbody><% results.forEach(c => { %><tr><td>#<%= c.caseId %></td><td><%= c.childFirst %> <%= c.childLast %></td><td><%= c.caseType %></td><td><%= c.status === 'UnderInvestigation' ? 'Under investigation' : c.status %></td><td><%= new Date(c.dateReported).toLocaleDateString('en-GB') %></td><td><a class="cadms-btn cadms-btn--outline cadms-btn--sm" href="/cases/<%= c.caseId %>">Open case</a></td></tr><% }) %><% if (!results.length) { %><tr><td colspan="6">No matching cases found.</td></tr><% } %></tbody></table></div></section><% } %>
<%- include('../partials/pageFooter') %>
