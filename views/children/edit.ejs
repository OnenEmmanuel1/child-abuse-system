<%- include('../partials/pageHeader', { pageHeading: `Edit child #${child.childId}` }) %>
<form class="cadms-card cadms-card__body cadms-form" method="post" action="/children/<%= child.childId %>/edit"><div class="cadms-form-row"><div class="cadms-form-group"><label for="firstName">First name *</label><input class="cadms-input" id="firstName" name="firstName" value="<%= child.firstName %>" required></div><div class="cadms-form-group"><label for="lastName">Last name *</label><input class="cadms-input" id="lastName" name="lastName" value="<%= child.lastName %>" required></div></div><div class="cadms-form-row"><div class="cadms-form-group"><label for="dateOfBirth">Date of birth</label><input class="cadms-input" type="date" id="dateOfBirth" name="dateOfBirth" value="<%= child.dateOfBirth ? new Date(child.dateOfBirth).toISOString().slice(0,10) : '' %>"></div><div class="cadms-form-group"><label for="gender">Gender</label><input class="cadms-input" id="gender" name="gender" value="<%= child.gender || '' %>"></div></div><div class="cadms-form-group"><label for="guardianContact">Guardian contact</label><input class="cadms-input" id="guardianContact" name="guardianContact" value="<%= child.guardianContact || '' %>"></div><div class="cadms-form-group"><label for="address">Address</label><input class="cadms-input" id="address" name="address" value="<%= child.address || '' %>"></div><div class="cadms-form-actions"><button class="cadms-btn cadms-btn--primary">Save changes</button><a class="cadms-btn cadms-btn--outline" href="/children/<%= child.childId %>">Cancel</a></div></form>
<%- include('../partials/pageFooter') %>
