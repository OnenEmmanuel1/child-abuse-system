<%- include('../partials/pageHeader', { pageHeading: 'Children', actionHref: '/children/create', actionLabel: 'Add child record' }) %>
<section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Child records</h2><span><%= children.length %> records</span></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Record</th><th>Date of birth</th><th>Gender</th><th></th></tr></thead><tbody><% children.forEach(c => { %><tr><td><a href="/children/<%= c.childId %>"><%= c.firstName %> <%= c.lastName %></a><small class="cadms-table-subtext">ID #<%= c.childId %></small></td><td><%= c.dateOfBirth ? new Date(c.dateOfBirth).toLocaleDateString('en-GB') : '—' %></td><td><%= c.gender || '—' %></td><td><a class="cadms-btn cadms-btn--outline cadms-btn--sm" href="/children/<%= c.childId %>">View record</a></td></tr><% }) %><% if (!children.length) { %><tr><td colspan="4">No child records are available to your account.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/pageFooter') %>
