<%- include('../partials/pageHeader', { pageHeading: `Child record #${child.childId}`, actionHref: `/children/${child.childId}/edit`, actionLabel: 'Edit record' }) %>
<section class="cadms-card cadms-card__body"><div class="cadms-detail-grid"><div class="cadms-detail-item"><div class="cadms-detail-item__label">Name</div><div class="cadms-detail-item__value"><%= child.firstName %> <%= child.lastName %></div></div><div class="cadms-detail-item"><div class="cadms-detail-item__label">Date of birth</div><div class="cadms-detail-item__value"><%= child.dateOfBirth ? new Date(child.dateOfBirth).toLocaleDateString('en-GB') : '—' %></div></div><div class="cadms-detail-item"><div class="cadms-detail-item__label">Gender</div><div class="cadms-detail-item__value"><%= child.gender || '—' %></div></div><div class="cadms-detail-item"><div class="cadms-detail-item__label">Guardian contact</div><div class="cadms-detail-item__value"><%= child.guardianContact || '—' %></div></div><div class="cadms-detail-item cadms-detail-item--full"><div class="cadms-detail-item__label">Address</div><div class="cadms-detail-item__value"><%= child.address || '—' %></div></div></div></section>
<%- include('../partials/pageFooter') %>
