<%- include('../partials/pageHeader', { pageHeading: `Edit investigation #${inv.investigationId}` }) %>
<form class="cadms-card cadms-card__body cadms-form" method="post" action="/investigations/<%= inv.investigationId %>/edit"><div class="cadms-form-group"><label for="status">Status</label><select class="cadms-select" id="status" name="status" required><% INV_STATUS.forEach(s => { %><option value="<%= s %>" <%= inv.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div><div class="cadms-form-group"><label for="progressNotes">Progress notes</label><textarea class="cadms-textarea" id="progressNotes" name="progressNotes"><%= inv.progressNotes || '' %></textarea></div><div class="cadms-form-actions"><button class="cadms-btn cadms-btn--primary">Save changes</button><a class="cadms-btn cadms-btn--outline" href="/cases/<%= inv.caseId %>">Cancel</a></div></form>
<%- include('../partials/pageFooter') %>
