<%- include('../partials/pageHeader', { pageHeading: `Add investigation · Case #${caseRecord.caseId}` }) %>
<form class="cadms-card cadms-card__body cadms-form" method="post" action="/investigations/create/<%= caseRecord.caseId %>"><div class="cadms-form-group"><label for="investigatorId">Investigator</label><select class="cadms-select" id="investigatorId" name="investigatorId" required><% caseworkers.forEach(u => { %><option value="<%= u.userId %>" <%= u.userId === currentUser.userId ? 'selected' : '' %>><%= u.fullName %></option><% }) %></select></div><div class="cadms-form-group"><label for="status">Status</label><select class="cadms-select" id="status" name="status" required><% INV_STATUS.forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %></select></div><div class="cadms-form-group"><label for="progressNotes">Progress notes</label><textarea class="cadms-textarea" id="progressNotes" name="progressNotes"></textarea></div><div class="cadms-form-actions"><button class="cadms-btn cadms-btn--primary">Save investigation</button><a class="cadms-btn cadms-btn--outline" href="/cases/<%= caseRecord.caseId %>">Cancel</a></div></form>
<%- include('../partials/pageFooter') %>
