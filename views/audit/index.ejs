<%- include('../partials/pageHeader', { pageHeading: 'Audit log' }) %>
<section class="cadms-card"><form class="cadms-filters" method="get" action="/audit"><div class="cadms-form-group"><label for="targetTable">Record type</label><select class="cadms-select" id="targetTable" name="targetTable"><option value="">All</option><% ['abuse_case','child','offender','investigation','users'].forEach(t => { %><option <%= filters.targetTable === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div><div class="cadms-form-group"><label for="userId">User</label><select class="cadms-select" id="userId" name="userId"><option value="">All users</option><% users.forEach(u => { %><option value="<%= u.userId %>" <%= String(filters.userId) === String(u.userId) ? 'selected' : '' %>><%= u.fullName %></option><% }) %></select></div><div class="cadms-form-group"><label for="action">Action</label><select class="cadms-select" id="action" name="action"><option value="">All actions</option><% ['View','Create','Update','Delete'].forEach(a => { %><option <%= filters.action === a ? 'selected' : '' %>><%= a %></option><% }) %></select></div><div class="cadms-form-group"><label for="dateFrom">From</label><input class="cadms-input" id="dateFrom" type="date" name="dateFrom" value="<%= filters.dateFrom %>"></div><div class="cadms-form-group"><label for="dateTo">To</label><input class="cadms-input" id="dateTo" type="date" name="dateTo" value="<%= filters.dateTo %>"></div><button class="cadms-btn cadms-btn--primary">Filter log</button><a class="cadms-btn cadms-btn--outline" href="/audit">Clear</a></form></section>
<section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Recorded access and changes</h2><span><%= pagination.total %> entries</span></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Time</th><th>Person</th><th>Action</th><th>Record type</th><th>Record ID</th></tr></thead><tbody><% entries.forEach(e => { %><tr><td><%= new Date(e.timestamp).toLocaleString('en-GB') %></td><td><%= e.performedBy %> (<%= e.username %>)</td><td><%= e.action %></td><td><%= e.targetTable %></td><td>#<%= e.targetId %></td></tr><% }) %><% if (!entries.length) { %><tr><td colspan="5">No audit entries match these filters.</td></tr><% } %></tbody></table></div><div class="cadms-card__body">Page <%= pagination.currentPage %> of <%= Math.max(pagination.totalPages, 1) %> <% if (pagination.currentPage > 1) { %><a class="cadms-btn cadms-btn--outline cadms-btn--sm" href="?page=<%= pagination.currentPage - 1 %>">Previous page</a><% } %> <% if (pagination.currentPage < pagination.totalPages) { %><a class="cadms-btn cadms-btn--outline cadms-btn--sm" href="?page=<%= pagination.currentPage + 1 %>">Next page</a><% } %></div></section>
<%- include('../partials/pageFooter') %>
