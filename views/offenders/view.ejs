<%- include('../partials/pageHeader', { pageHeading: `Offender record #${offender.offenderId}`, actionHref: `/offenders/${offender.offenderId}/edit`, actionLabel: 'Edit record' }) %>
<section class="cadms-card cadms-card__body"><div class="cadms-detail-grid"><div class="cadms-detail-item"><div class="cadms-detail-item__label">Full name</div><div class="cadms-detail-item__value"><%= offender.fullName || 'Unknown' %></div></div><div class="cadms-detail-item"><div class="cadms-detail-item__label">Known aliases</div><div class="cadms-detail-item__value"><%= offender.knownAliases || '—' %></div></div><div class="cadms-detail-item"><div class="cadms-detail-item__label">Last known address</div><div class="cadms-detail-item__value"><%= offender.lastKnownAddress || '—' %></div></div><div class="cadms-detail-item cadms-detail-item--full"><div class="cadms-detail-item__label">Identifying details</div><div class="cadms-detail-item__value"><%= offender.identifyingDetails || '—' %></div></div></div></section>
<section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Linked cases</h2><span><%= linkedCases.length %> cases</span></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Case</th><th>Type</th><th>Status</th><th>Date reported</th><th>Caseworker</th></tr></thead><tbody><% linkedCases.forEach(c => { %><tr><td><a href="/cases/<%= c.caseId %>">#<%= c.caseId %> · <%= c.childFirst %> <%= c.childLast %></a></td><td><%= c.caseType %></td><td><%= c.status %></td><td><%= new Date(c.dateReported).toLocaleDateString('en-GB') %></td><td><%= c.caseworkerName || 'Unassigned' %></td></tr><% }) %><% if (!linkedCases.length) { %><tr><td colspan="5">No accessible linked cases.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/pageFooter') %>
