<%- include('../partials/pageHeader', { pageHeading: 'Offender records', actionHref: '/offenders/create', actionLabel: 'Add offender record' }) %>
<section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Records linked to accessible cases</h2><span><%= offenders.length %> records</span></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Record</th><th>Known aliases</th><th>Last known address</th><th></th></tr></thead><tbody><% offenders.forEach(o => { %><tr><td><a href="/offenders/<%= o.offenderId %>"><%= o.fullName || 'Unknown' %></a><small class="cadms-table-subtext">ID #<%= o.offenderId %></small></td><td><%= o.knownAliases || '—' %></td><td><%= o.lastKnownAddress || '—' %></td><td><a class="cadms-btn cadms-btn--outline cadms-btn--sm" href="/offenders/<%= o.offenderId %>">View linked cases</a></td></tr><% }) %><% if (!offenders.length) { %><tr><td colspan="4">No linked offender records are available.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/pageFooter') %>
