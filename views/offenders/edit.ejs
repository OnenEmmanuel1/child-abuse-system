<%- include('../partials/pageHeader', { pageHeading: `Edit offender #${offender.offenderId}` }) %>
<form class="cadms-card cadms-card__body cadms-form" method="post" action="/offenders/<%= offender.offenderId %>/edit"><div class="cadms-form-group"><label for="fullName">Full name</label><input class="cadms-input" id="fullName" name="fullName" value="<%= offender.fullName || '' %>"></div><div class="cadms-form-group"><label for="knownAliases">Known aliases</label><input class="cadms-input" id="knownAliases" name="knownAliases" value="<%= offender.knownAliases || '' %>"></div><div class="cadms-form-group"><label for="lastKnownAddress">Last known address</label><input class="cadms-input" id="lastKnownAddress" name="lastKnownAddress" value="<%= offender.lastKnownAddress || '' %>"></div><div class="cadms-form-group"><label for="identifyingDetails">Identifying details</label><textarea class="cadms-textarea" id="identifyingDetails" name="identifyingDetails"><%= offender.identifyingDetails || '' %></textarea></div><div class="cadms-form-actions"><button class="cadms-btn cadms-btn--primary">Save changes</button><a class="cadms-btn cadms-btn--outline" href="/offenders/<%= offender.offenderId %>">Cancel</a></div></form>
<%- include('../partials/pageFooter') %>
