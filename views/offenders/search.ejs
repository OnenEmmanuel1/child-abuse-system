<%- include('../partials/pageHeader', { pageHeading: 'Offender tracking', actionHref: '/offenders/create', actionLabel: 'Add offender record' }) %>
<section class="cadms-card"><form class="cadms-filters" method="get" action="/offenders-search"><div class="cadms-form-group"><label for="q">Name, alias, or identifying detail</label><input class="cadms-input" id="q" name="q" value="<%= query %>" placeholder="Enter search terms"></div><button class="cadms-btn cadms-btn--primary">Search records</button><a class="cadms-btn cadms-btn--outline" href="/offenders-search">Clear</a></form></section>
<% if (results) { %><section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Matching records</h2><span><%= results.length %> results</span></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Record</th><th>Aliases</th><th>Linked cases</th><th></th></tr></thead><tbody><% results.forEach(o => { %><tr><td><a href="/offenders/<%= o.offenderId %>"><%= o.fullName || 'Unknown' %> · #<%= o.offenderId %></a></td><td><%= o.knownAliases || '—' %></td><td>View linked cases</td><td><a class="cadms-btn cadms-btn--outline cadms-btn--sm" href="/offenders/<%= o.offenderId %>">Open record</a></td></tr><% }) %><% if (!results.length) { %><tr><td colspan="4">No matching records found in your accessible cases.</td></tr><% } %></tbody></table></div></section><% } else { %><section class="cadms-card cadms-card__body"><h2>Search across linked records</h2><p>Results are limited to records connected to cases you are authorized to access.</p></section><% } %>
<%- include('../partials/pageFooter') %>
