<%- include('../partials/pageHeader', { pageHeading: 'User management', actionHref: '/users/create', actionLabel: 'Create user' }) %>
<section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Authorized personnel</h2><span><%= users.length %> accounts</span></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Agency</th><th>Account</th><th></th></tr></thead><tbody><% users.forEach(u => { %><tr><td><%= u.fullName %></td><td><%= u.username %></td><td><%= u.role %></td><td><%= u.agency || '—' %></td><td><%= u.active ? 'Active' : 'Inactive' %></td><td><a class="cadms-btn cadms-btn--outline cadms-btn--sm" href="/users/<%= u.userId %>/edit">Edit account</a></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/pageFooter') %>
