<%- include('../partials/pageHeader', { pageHeading: 'Create authorized account' }) %>
<form class="cadms-card cadms-card__body cadms-form" method="post" action="/users/create"><div class="cadms-form-row"><div class="cadms-form-group"><label for="fullName">Full name *</label><input class="cadms-input" id="fullName" name="fullName" maxlength="100" required></div><div class="cadms-form-group"><label for="username">Username *</label><input class="cadms-input" id="username" name="username" maxlength="50" autocomplete="off" required></div></div><div class="cadms-form-row"><div class="cadms-form-group"><label for="password">Temporary password *</label><input class="cadms-input" id="password" name="password" type="password" minlength="8" autocomplete="new-password" required></div><div class="cadms-form-group"><label for="role">Role *</label><select class="cadms-select" id="role" name="role" required><option value="Caseworker">Caseworker</option><option value="Administrator">Administrator</option></select></div></div><div class="cadms-form-group"><label for="agency">Agency</label><input class="cadms-input" id="agency" name="agency" maxlength="100"></div><div class="cadms-form-actions"><button class="cadms-btn cadms-btn--primary">Create account</button><a class="cadms-btn cadms-btn--outline" href="/users">Cancel</a></div></form>
<%- include('../partials/pageFooter') %>
