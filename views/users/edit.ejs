<%- include('../partials/pageHeader', { pageHeading: `Edit user · ${editUser.fullName}` }) %>
<form class="cadms-card cadms-card__body cadms-form" method="post" action="/users/<%= editUser.userId %>/edit"><div class="cadms-form-row"><div class="cadms-form-group"><label for="fullName">Full name *</label><input class="cadms-input" id="fullName" name="fullName" value="<%= editUser.fullName %>" required></div><div class="cadms-form-group"><label for="username">Username *</label><input class="cadms-input" id="username" name="username" value="<%= editUser.username %>" required></div></div><div class="cadms-form-row"><div class="cadms-form-group"><label for="role">Role</label><select class="cadms-select" id="role" name="role"><% ['Caseworker','Administrator'].forEach(r => { %><option <%= editUser.role === r ? 'selected' : '' %>><%= r %></option><% }) %></select></div><div class="cadms-form-group"><label for="agency">Agency</label><input class="cadms-input" id="agency" name="agency" value="<%= editUser.agency || '' %>"></div></div><div class="cadms-form-group"><label for="password">Set new password (optional, at least 8 characters)</label><input class="cadms-input" id="password" type="password" name="password" minlength="8" autocomplete="new-password"></div><label class="cadms-checkbox"><input type="checkbox" name="active" <%= editUser.active ? 'checked' : '' %>> Account is active</label><div class="cadms-form-actions"><button class="cadms-btn cadms-btn--primary">Save user</button><a class="cadms-btn cadms-btn--outline" href="/users">Cancel</a></div></form>
<%- include('../partials/pageFooter') %>
