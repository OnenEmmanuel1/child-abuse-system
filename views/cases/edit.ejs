<%- include('../partials/pageHeader', { pageHeading: `Edit case #${caseRecord.caseId}` }) %>
<form class="cadms-card cadms-card__body cadms-form" method="post" action="/cases/<%= caseRecord.caseId %>/edit">
  <div class="cadms-form-row"><div class="cadms-form-group"><label for="childId">Child record</label><select class="cadms-select" id="childId" name="childId" required><% children.forEach(c => { %><option value="<%= c.childId %>" <%= c.childId === caseRecord.childId ? 'selected' : '' %>><%= c.firstName %> <%= c.lastName %> (ID <%= c.childId %>)</option><% }) %></select></div><div class="cadms-form-group"><label for="offenderId">Linked offender</label><select class="cadms-select" id="offenderId" name="offenderId"><option value="">Not linked</option><% offenders.forEach(o => { %><option value="<%= o.offenderId %>" <%= o.offenderId === caseRecord.offenderId ? 'selected' : '' %>><%= o.fullName || 'Unknown' %> (ID <%= o.offenderId %>)</option><% }) %></select></div></div>
  <div class="cadms-form-row"><div class="cadms-form-group"><label for="caseType">Case type</label><select class="cadms-select" id="caseType" name="caseType" required><% CASE_TYPES.forEach(t => { %><option <%= t === caseRecord.caseType ? 'selected' : '' %> value="<%= t %>"><%= t %></option><% }) %></select></div><div class="cadms-form-group"><label for="dateReported">Date reported</label><input class="cadms-input" type="date" id="dateReported" name="dateReported" required value="<%= new Date(caseRecord.dateReported).toISOString().slice(0,10) %>"></div></div>
  <div class="cadms-form-row"><div class="cadms-form-group"><label for="status">Status</label><select class="cadms-select" id="status" name="status"><% CASE_STATUS.forEach(s => { %><option <%= s === caseRecord.status ? 'selected' : '' %> value="<%= s %>"><%= s %></option><% }) %></select></div><% if (currentUser.role === 'Administrator') { %><div class="cadms-form-group"><label for="assignedCaseworker">Assigned caseworker</label><select class="cadms-select" id="assignedCaseworker" name="assignedCaseworker"><option value="">Unassigned</option><% caseworkers.forEach(u => { %><option value="<%= u.userId %>" <%= u.userId === caseRecord.assignedCaseworker ? 'selected' : '' %>><%= u.fullName %></option><% }) %></select></div><% } %></div>
  <div class="cadms-form-group"><label for="notes">Administrative notes</label><textarea class="cadms-textarea" id="notes" name="notes"><%= caseRecord.notes || '' %></textarea></div><div class="cadms-form-actions"><button class="cadms-btn cadms-btn--primary">Save changes</button><a class="cadms-btn cadms-btn--outline" href="/cases/<%= caseRecord.caseId %>">Cancel</a></div>
</form>
<%- include('../partials/pageFooter') %>
