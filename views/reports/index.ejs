<%- include('../partials/pageHeader', { pageHeading: 'Aggregate reports' }) %>
<section class="cadms-stats"><div class="cadms-stat cadms-stat--primary"><div class="cadms-stat__label">Total cases</div><div class="cadms-stat__value"><%= summary.totalCases %></div></div><div class="cadms-stat cadms-stat--warning"><div class="cadms-stat__label">Reported</div><div class="cadms-stat__value"><%= summary.reportedCases %></div></div><div class="cadms-stat cadms-stat--info"><div class="cadms-stat__label">Under investigation</div><div class="cadms-stat__value"><%= summary.activeCases %></div></div><div class="cadms-stat cadms-stat--success"><div class="cadms-stat__label">Closed</div><div class="cadms-stat__value"><%= summary.closedCases %></div></div></section>
<section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Cases by type and reporting period</h2></div><form class="cadms-filters" method="get" action="/reports"><div class="cadms-form-group"><label for="dateFrom">From</label><input class="cadms-input" id="dateFrom" type="date" name="dateFrom" value="<%= dateFrom %>"></div><div class="cadms-form-group"><label for="dateTo">To</label><input class="cadms-input" id="dateTo" type="date" name="dateTo" value="<%= dateTo %>"></div><button class="cadms-btn cadms-btn--primary">Apply period</button><a class="cadms-btn cadms-btn--outline" href="/reports">Clear</a></form><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Case type</th><th>Count</th></tr></thead><tbody><% byType.forEach(r => { %><tr><td><%= r.caseType %></td><td><%= r.caseCount %></td></tr><% }) %><% if (!byType.length) { %><tr><td colspan="2">No aggregate results for this period.</td></tr><% } %></tbody></table></div></section>
<div class="cadms-report-grid"><section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Cases by status</h2></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Status</th><th>Count</th></tr></thead><tbody><% byStatus.forEach(r => { %><tr><td><%= r.status === 'UnderInvestigation' ? 'Under investigation' : r.status %></td><td><%= r.caseCount %></td></tr><% }) %></tbody></table></div></section>
<section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Monthly trend</h2></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Month</th><th>Cases reported</th></tr></thead><tbody><% trend.forEach(r => { %><tr><td><%= r.period %></td><td><%= r.caseCount %></td></tr><% }) %><% if (!trend.length) { %><tr><td colspan="2">No trend data available.</td></tr><% } %></tbody></table></div></section></div>
<section class="cadms-card"><div class="cadms-card__header"><h2 class="cadms-card__title">Caseworker workload summary</h2></div><div class="cadms-table-wrap"><table class="cadms-table"><thead><tr><th>Caseworker</th><th>Total</th><th>Reported</th><th>In progress</th><th>Closed</th></tr></thead><tbody><% byCaseworker.forEach(r => { %><tr><td><%= r.caseworkerName %></td><td><%= r.caseCount %></td><td><%= r.reported %></td><td><%= r.underInvestigation %></td><td><%= r.closed %></td></tr><% }) %></tbody></table></div></section>
<p class="cadms-help-text">Reports contain aggregate statistics only; no individual child or offender details are included.</p>
<%- include('../partials/pageFooter') %>
