# ─────────────────────────────────────────────────────────────
# CADMS Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cadms

# Session
SESSION_SECRET=replace_with_a_long_random_string_minimum_64_chars

# Bcrypt
BCRYPT_SALT_ROUNDS=12
